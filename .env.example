# ========================
# Aplicação
# ========================
VITE_APP_NAME="GoodWe ChargeGrid"
# development | staging | production
VITE_APP_ENV=development

# ========================
# Back-end (goodwe-service-app)
# ========================
# URL base COM o prefixo global do Nest (API_PREFIX=api)
VITE_API_URL=http://localhost:3000/api
# Remoto: VITE_API_URL=https://goodwe-challenge-service.onrender.com/api
# Timeout das requisições em ms
VITE_API_TIMEOUT=10000

# ========================
# Comportamento
# ========================
# Intervalo (ms) de atualização da tela de uma sessão em andamento
VITE_SESSION_POLL_INTERVAL=5000
